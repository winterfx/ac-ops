#!/usr/bin/env bash
# Read-only git access to the agent-compose source synced into this project.
#
# Usage: acsrc <git args...>, e.g.
#   acsrc grep -n "wire api mismatch" llm-facade-2609.4.5 -- pkg
#   acsrc log --oneline llm-facade-2609.4.5..origin/main -- pkg/agentcompose/proxy
#
# The checkout is a read-only mount owned by another uid, so git's
# dubious-ownership check is relaxed for this one command.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
exec git -c safe.directory='*' -C "${ACOPS_SRC:-$here/../src/agent-compose}" "$@"
